{
  "name": "tft-openers",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "sandbox": ".sandbox/with-secrets.sh msb exec --tty $(.sandbox/name.sh)",
    "sandbox:create": "mkdir -p node_modules && .sandbox/with-secrets.sh msb create --name $(.sandbox/name.sh) --conf msb-config.yaml",
    "sandbox:stop": "msb stop $(.sandbox/name.sh)",
    "sandbox:remove": "msb remove --force $(.sandbox/name.sh)"
  }
}
